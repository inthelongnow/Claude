# === Mem0 OpenMemory Self-Hosted Config ===
# Fully local — no OpenAI dependency

# LLM Configuration (Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://ollama:11434

# Embedder Configuration (Ollama)
